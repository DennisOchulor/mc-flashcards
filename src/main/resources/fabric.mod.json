{
  "schemaVersion": 1,
  "id": "flashcards",
  "version": "${version}",
  "name": "Flashcards: Anki + AI Edition",
  "description": "Study your Anki deck in Minecraft, with answers graded by a local AI (Ollama). Fork of Flashcards by DennisOchulor; not an official release.",
  "authors": [
    {
      "name": "IvanIvanochko",
      "contact": {
        "homepage": "https://github.com/IvanIvanochko"
      }
    },
    "Ninjaking312"
  ],
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "accessWidener": "flashcards.classtweaker",
  "entrypoints": {
    "client": [
      "io.github.dennisochulor.flashcards.Flashcards"
    ],
    "modmenu": ["io.github.dennisochulor.flashcards.compat.ModMenuCompat"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": ">=${minecraft_version}"
  }
}
